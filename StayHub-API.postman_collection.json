{
  "info": {
    "name": "StayHub API",
    "description": "Complete API collection for StayHub Hotel Booking",
    "version": "1.0.0"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\"firstName\": \"John\", \"lastName\": \"Doe\", \"email\": \"john@example.com\", \"password\": \"password123\", \"phone\": \"+1234567890\"}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"john@example.com\", \"password\": \"password123\"}"
            }
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{baseUrl}}/api/auth/profile"
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": "{{baseUrl}}/api/auth/profile",
            "body": {
              "mode": "raw",
              "raw": "{\"firstName\": \"John\", \"lastName\": \"Smith\", \"phone\": \"+19876543210\"}"
            }
          }
        }
      ]
    },
    {
      "name": "Hotels",
      "item": [
        {
          "name": "Get All Hotels",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/hotels"
          }
        },
        {
          "name": "Search Hotels",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/hotels/search?city=New%20York&checkIn=2024-01-01&checkOut=2024-01-05&guests=2"
          }
        },
        {
          "name": "Get Hotel by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/hotels/{{hotelId}}"
          }
        },
        {
          "name": "Create Hotel",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": "{{baseUrl}}/api/hotels",
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Grand Hotel\", \"description\": \"5-star luxury hotel\", \"location\": {\"address\": \"123 Main St\", \"city\": \"New York\", \"country\": \"USA\"}, \"images\": [], \"amenities\": [\"WiFi\", \"Pool\", \"Gym\"], \"rooms\": [{\"roomNumber\": \"101\", \"type\": \"Deluxe\", \"capacity\": 2, \"basePrice\": 250}]}"
            }
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Create Booking",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": "{{baseUrl}}/api/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\"hotelId\": \"{{hotelId}}\", \"roomId\": \"101\", \"checkInDate\": \"2024-01-01\", \"checkOutDate\": \"2024-01-05\", \"numberOfGuests\": 2, \"specialRequests\": \"High floor preferred\"}"
            }
          }
        },
        {
          "name": "Get Bookings",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{baseUrl}}/api/bookings"
          }
        },
        {
          "name": "Get Booking by ID",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}"
          }
        },
        {
          "name": "Setup Contactless Check-in",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}/contactless-checkin"
          }
        },
        {
          "name": "Confirm Check-in",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}/confirm-checkin"
          }
        },
        {
          "name": "Cancel Booking",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}/cancel",
            "body": {
              "mode": "raw",
              "raw": "{\"cancellationReason\": \"Change of plans\"}"
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": "your_jwt_token_here"
    },
    {
      "key": "hotelId",
      "value": "your_hotel_id_here"
    },
    {
      "key": "bookingId",
      "value": "your_booking_id_here"
    }
  ]
}
