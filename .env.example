# Server Configuration
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:4200

# JWT Secret
JWT_SECRET=your_secret_jwt_key_here_change_in_production
JWT_EXPIRE=7d

# CORS
CORS_ORIGIN=http://localhost:4200

# Email Configuration — Resend (HTTP API, not SMTP — many hosts including Render block
# outbound SMTP ports, which is why this replaced the old Gmail SMTP setup)
RESEND_API_KEY=your_resend_api_key
# Optional — defaults to Resend's shared onboarding@resend.dev sender if unset (no domain
# verification required). Set this once you've verified your own sending domain with Resend.
RESEND_FROM_EMAIL=FinSmartHotels <onboarding@resend.dev>

# Mobile app download link — sent to guests in the reception/walk-in booking confirmation
# email. The email link is skipped entirely if this is empty.
MOBILE_APP_DOWNLOAD_URL=https://github.com/asena01/marketplace-vendor/releases/download/finsm/stayhub-mobile.apk

# Payment Gateway (optional)
STRIPE_SECRET_KEY=your_stripe_secret_key
PAYPAL_CLIENT_ID=your_paypal_client_id

# Flutterwave Payment Gateway
FLUTTERWAVE_PUBLIC_KEY=your_flutterwave_public_key
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key
FLUTTERWAVE_ENCRYPTION_KEY=your_flutterwave_encryption_key

# AWS S3 (for image uploads - optional)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=your_bucket_name

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

